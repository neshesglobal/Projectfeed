{
  "name": "@projectfeed/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts && tsx src/scripts/seed-videos.ts && tsx src/scripts/seed-moderation.ts && tsx src/scripts/seed-trust.ts && tsx src/scripts/seed-notes.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "@projectfeed/shared": "workspace:*",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "maxmind": "^5.0.7",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
