DATABASE_URL=postgres://projectfeed:projectfeed@localhost:5432/projectfeed
JWT_SECRET=change-me-to-a-64-char-random-string
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=./uploads
# Set to true once the KYC vendor flow is live: unverified users become read-only.
KYC_ENFORCED=false

# Upload screening (see docs/MODERATION.md). Required in production.
# SCREENING_HASH_LIST=./hash-list.txt     # local list: sha256:/md5:/dhash: entries (benign test hashes only)
# SCREENING_LIST_NAME=local
# SCREENING_PROVIDER=photodna             # once the vendor agreement is in place
# SCREENING_DISABLED=true                 # explicit opt-out; never in production
