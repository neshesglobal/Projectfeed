DATABASE_URL=postgres://projectfeed:projectfeed@localhost:5432/projectfeed
JWT_SECRET=change-me-to-a-64-char-random-string
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=./uploads
# Set to true once the KYC vendor flow is live: unverified users become read-only.
KYC_ENFORCED=false

# Upload screening (see docs/MODERATION.md). Required in production.
# SCREENING_HASH_LIST=./hash-list.txt     # local list: sha256:/md5:/dhash: entries (benign test hashes only)
# SCREENING_LIST_NAME=local
# SCREENING_PROVIDER=photodna             # once the vendor agreement is in place
# SCREENING_DISABLED=true                 # explicit opt-out; never in production

# Post translation (see docs/TRANSLATION.md). Unset in development = demo translations of the seed posts.
# TRANSLATE_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=
# TRANSLATE_LANGUAGES=en,hi,bn,mr,te,ta,gu,ur,kn,or,ml,pa
# TRANSLATE_DAILY_CHAR_BUDGET=2000000
# TRANSLATE_RATE_LIMIT_PER_MIN=30

# GIF button in the composer. Unset in development = a few locally generated demo GIFs.
# GIPHY: free key at developers.giphy.com (beta keys are rate-limited; apply for a production key before launch).
# GIF_PROVIDER=giphy
# GIPHY_API_KEY=
# Tenor (Google): key from Google Cloud console, Tenor API.
# GIF_PROVIDER=tenor
# TENOR_API_KEY=
